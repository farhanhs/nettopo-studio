# Production-safe defaults. Development/demo gates are off unless explicitly enabled.
NETTOPO_RUNTIME_PROFILE=production
NETTOPO_AUTH_MODE=disabled
NETTOPO_ENABLE_DEV_IDENTITY_HEADER=0
NETTOPO_ENABLE_DEMO_SEED=0
NEXT_PUBLIC_TOPOLOGY_STORAGE=indexeddb

# Set this to server to use the PostgreSQL-backed API.
# NEXT_PUBLIC_TOPOLOGY_STORAGE=server
DATABASE_URL=postgres://nettopo_runtime:REPLACE_WITH_RUNTIME_PASSWORD@localhost:5432/nettopo_studio
# Migration CLI uses a separate explicit DSN and never falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://nettopo:REPLACE_WITH_MIGRATION_PASSWORD@localhost:5432/nettopo_studio
POSTGRES_POOL_MAX=1

# Base64-encoded 32-byte AES key. Keep the real value outside source control.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NETTOPO_CREDENTIAL_ENCRYPTION_KEY=
NETTOPO_CREDENTIAL_KEY_VERSION=v1

# Local development example:
# NETTOPO_RUNTIME_PROFILE=development
# NETTOPO_AUTH_MODE=demo
# NETTOPO_ENABLE_DEV_IDENTITY_HEADER=1
# NETTOPO_ENABLE_DEMO_SEED=1
# NETTOPO_DEV_SESSION_SECRET=replace-with-local-random-secret

# Internal Pilot example:
# NETTOPO_RUNTIME_PROFILE=pilot
# NETTOPO_AUTH_MODE=pilot
# NETTOPO_ENABLE_DEV_IDENTITY_HEADER=0
# NETTOPO_ENABLE_DEMO_SEED=0
# NETTOPO_PILOT_SITE_ID=pilot-site
# NETTOPO_PILOT_USERS=pilot.admin@company.local:admin:1,pilot.engineer@company.local:engineer:1
# NETTOPO_PILOT_SESSION_SECRET=replace-with-32-plus-character-random-secret
# NETTOPO_PILOT_ALLOW_FULL_EXPORT=0
